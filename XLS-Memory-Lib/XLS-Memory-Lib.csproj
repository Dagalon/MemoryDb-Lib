<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XLS_Memory_Lib</RootNamespace>
    <AssemblyName>XLS-Memory-Lib</AssemblyName>
    <PackageId>XLS-Memory-Lib</PackageId>
    <Version>1.0.0</Version>
    <Description>Excel-DNA add-in exposing Memory.DB helpers as Excel worksheet functions.</Description>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RunExcelDnaPack>true</RunExcelDnaPack>
    <ExcelAddInFileName>XLS-Memory-Lib</ExcelAddInFileName>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
    <ExcelDna64BitAddInSuffix>%none%</ExcelDna64BitAddInSuffix>
    <ExcelDnaPackXllSuffix>%none%</ExcelDnaPackXllSuffix>
    <ExcelDnaPackCompressResources>true</ExcelDnaPackCompressResources>
    <ExcelDnaPackRunMultithreaded>true</ExcelDnaPackRunMultithreaded>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Update="Microsoft.Data.Sqlite" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memory-Db\Memory-Db.csproj" />
  </ItemGroup>

</Project>
